# ==========================================
# AI Orb Assistant · 后端环境变量模板
# 使用方法：cp .env.example .env 后按需修改
# 所有变量都有代码内默认值，不创建 .env 也能直接运行
# ==========================================

# 服务监听端口
PORT=3001

# 允许跨域访问的前端地址（CORS）
CLIENT_ORIGIN=http://localhost:5173

# ---------- 第二阶段预留：AI 服务 ----------
# 大语言模型 API Key（如 Anthropic Claude）
ANTHROPIC_API_KEY=

# 语音识别（STT）/ 语音合成（TTS）服务预留
# STT_API_KEY=
# TTS_API_KEY=
